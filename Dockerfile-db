#
# NOTE: THIS DOCKERFILE IS GENERATED VIA "make update"! PLEASE DO NOT EDIT IT DIRECTLY.
#
# EXCEPT: base image was moved from postgres:16-bullseye to postgres:16-bookworm on
# 2026-10-11 because Debian 11 "bullseye" LTS ended 2026-08-31 and its packages (both
# on deb.debian.org and apt.postgresql.org) are being removed from the live mirrors.
# Bookworm is the current stable base and needs none of the archive-repo workarounds
# bullseye now requires. PostgreSQL major version is unchanged (16), so existing data
# volumes remain compatible.
#

FROM postgres:16-bookworm

LABEL maintainer="PostGIS Project - https://postgis.net" \
      org.opencontainers.image.description="PostGIS 3 spatial database extension with PostgreSQL 16 bookworm" \
      org.opencontainers.image.source="https://github.com/postgis/docker-postgis"

ENV POSTGIS_MAJOR 3

RUN apt-get update \
      && apt-cache showpkg postgresql-$PG_MAJOR-postgis-$POSTGIS_MAJOR \
      && apt-get install -y --no-install-recommends \
           # ca-certificates: for accessing remote raster files;
           #   fix: https://github.com/postgis/docker-postgis/issues/307
           ca-certificates \
           \
           postgresql-$PG_MAJOR-postgis-$POSTGIS_MAJOR \
           postgresql-$PG_MAJOR-postgis-$POSTGIS_MAJOR-scripts \
      && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /docker-entrypoint-initdb.d
COPY ./db/initdb-postgis.sh /docker-entrypoint-initdb.d/10_postgis.sh
COPY ./db/update-postgis.sh /usr/local/bin
